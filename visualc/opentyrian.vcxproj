    <Dependency Condition="'$(WITH_MIDI)'!='true'" Include="$(SDL2BaseDir)\lib\x64\*.dll" />
    <!-- WITH_MIDI stages its ABI-compatible SDL2 and FluidSynth DLLs together. -->
    <Dependency Condition="'$(WITH_MIDI)'=='true'" Include="$(FluidSynthBaseDir)\lib\x64\*.dll" />
    <Dependency Include="$(SDL2netBaseDir)\lib\x64\*.dll" />
  </ItemGroup>
  <ItemGroup Condition="'$(Platform)'=='ARM64'">
    <Dependency Include="$(SDL2BaseDir)\lib\arm64\*.dll" />
    <Dependency Include="$(SDL2netBaseDir)\lib\arm64\*.dll" />
  </ItemGroup>
  <PropertyGroup>
    <BuildDependsOn>CopyPropsTemplates;EnsureSDLExists;$(BuildDependsOn)</BuildDependsOn>
  </PropertyGroup>
  <Target Name="CopyPropsTemplates">
    <Copy SourceFiles="opentyrian.props.template" DestinationFiles="opentyrian.props" Condition="!Exists('opentyrian.props')" />
    <Copy SourceFiles="sdl_paths.props.template" DestinationFiles="sdl_paths.props" Condition="!Exists('sdl_paths.props')" />
  </Target>
  <Target Name="EnsureSDLExists">
    <Error Condition="!Exists($(SDL2BaseDir))" Text="Set 'SDL2BaseDir' in 'sdl_paths.props' to the directory where SDL2 is located." />
    <Error Condition="!Exists($(SDL2netBaseDir))" Text="Set 'SDL2netBaseDir' in 'sdl_paths.props' to the directory where SDL2_net is located." />
    <Error Condition="'$(WITH_MIDI)'=='true' AND '$(Platform)'=='x64' AND !Exists($(FluidSynthBaseDir))" Text="Set 'FluidSynthBaseDir' in 'sdl_paths.props' to a FluidSynth SDK (the repo ships one in stuff\fluidsynth), or set WITH_MIDI=false in 'opentyrian.props'." />
    <!-- The official SDL VC packages ship x86 and x64 only, so ARM64 needs SDKs built from source. -->
    <Error Condition="'$(Platform)'=='ARM64' AND !Exists('$(SDL2BaseDir)\lib\arm64')" Text="'$(SDL2BaseDir)\lib\arm64' is missing. Point 'SDL2BaseDir' at an SDL2 built for ARM64; see README.md." />
    <Error Condition="'$(Platform)'=='ARM64' AND !Exists('$(SDL2netBaseDir)\lib\arm64')" Text="'$(SDL2netBaseDir)\lib\arm64' is missing. Point 'SDL2netBaseDir' at an SDL2_net built for ARM64; see README.md." />
  </Target>
  <Target Name="CopyDependencies" AfterTargets="Build">
    <Copy SourceFiles="@(Dependency)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>
</Project>
