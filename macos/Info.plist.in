<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleExecutable</key>
	<string>${MACOSX_BUNDLE_EXECUTABLE_NAME}</string>
	<key>CFBundleIdentifier</key>
	<string>${MACOSX_BUNDLE_GUI_IDENTIFIER}</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>${MACOSX_BUNDLE_BUNDLE_NAME}</string>
	<key>CFBundleDisplayName</key>
	<string>Tyrian 2000 Engaged</string>
	<!-- Basename of the .icns in Contents/Resources, which iconutil writes during the
	     build from macos/tyrian2000.iconset. -->
	<key>CFBundleIconFile</key>
	<string>${MACOSX_BUNDLE_ICON_FILE}</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>${MACOSX_BUNDLE_SHORT_VERSION_STRING}</string>
	<key>CFBundleVersion</key>
	<string>${MACOSX_BUNDLE_BUNDLE_VERSION}</string>
	<!-- Matches CMAKE_OSX_DEPLOYMENT_TARGET in CMakeLists.txt. -->
	<key>LSMinimumSystemVersion</key>
	<string>11.0</string>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.arcade-games</string>
	<!-- macOS 15 prompts for local network access the way iOS 14 does. Declaring the reason here
	     keeps online play and save transfers working once the user allows it. -->
	<key>NSLocalNetworkUsageDescription</key>
	<string>Tyrian 2000 Engaged uses the local network to find other devices for online play and to copy saved games between them.</string>
	<!-- Render into the display's high-resolution backing store. -->
	<key>NSHighResolutionCapable</key>
	<true/>
	<!-- The game renders a 320x200 playfield; there is no reason to wake a discrete GPU. -->
	<key>NSSupportsAutomaticGraphicsSwitching</key>
	<true/>
	<key>NSHumanReadableCopyright</key>
	<string>GNU General Public License v2 or later</string>
</dict>
</plist>
