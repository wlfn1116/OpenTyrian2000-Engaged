# Keep text files LF in the index and working tree.
* text=auto eol=lf

# Visual Studio rewrites these files as CRLF.
*.sln              text eol=crlf
*.rc               text eol=crlf
*.props            text eol=crlf
*.props.template   text eol=crlf

# Byte-exact assets and fixtures.
*.sav   binary
*.lib   binary
*.dll   binary
*.png   binary
*.jpg   binary
*.ico   binary

# Binary files copied into the tracked data dumps.
*.wav   binary
*.lds   binary
*.exe   binary
*.ovl   binary
*.sf2   binary
*.awe   binary
*.pif   binary
*.box   binary
dump/raw/config/tyrian.cfg binary
